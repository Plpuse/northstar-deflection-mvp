{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderStatusResponse",
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string",
      "example": "ORD-2026-9876"
    },
    "customerEmail": {
      "type": "string",
      "format": "email"
    },
    "orderStatus": {
      "type": "string",
      "enum": ["processing", "shipped", "delivered", "cancelled", "returned"]
    },
    "trackingNumber": {
      "type": "string",
      "nullable": true
    },
    "estimatedDelivery": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string" },
          "itemName": { "type": "string" },
          "quantity": { "type": "integer" },
          "unitPrice": { "type": "number" }
        },
        "required": ["itemId", "itemName", "quantity", "unitPrice"]
      }
    }
  },
  "required": ["orderId", "customerEmail", "orderStatus"]
}
